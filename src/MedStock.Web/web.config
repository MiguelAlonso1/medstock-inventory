<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet" stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout" hostingModel="outofprocess" />
      <!-- Blazor Server needs WebSockets (SignalR). Also enable the WebSocket Protocol feature in the host panel. -->
      <webSocket enabled="true" />
      <!-- Never serve certificate files left in the web root. -->
      <security>
        <requestFiltering>
          <fileExtensions>
            <remove fileExtension=".pfx" />
            <add fileExtension=".pfx" allowed="false" />
            <remove fileExtension=".db" />
            <add fileExtension=".db" allowed="false" />
            <remove fileExtension=".db-wal" />
            <add fileExtension=".db-wal" allowed="false" />
            <remove fileExtension=".db-shm" />
            <add fileExtension=".db-shm" allowed="false" />
          </fileExtensions>
          <hiddenSegments>
            <remove segment="App_Data" />
            <add segment="App_Data" />
            <remove segment="logs" />
            <add segment="logs" />
          </hiddenSegments>
        </requestFiltering>
      </security>
    </system.webServer>
  </location>

  <!-- Let's Encrypt validation files are extensionless static files: bypass the ASP.NET Core handler. -->
  <location path=".well-known" inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <remove name="aspNetCore" />
        <add name="StaticFile" path="*" verb="*" modules="StaticFileModule,DefaultDocumentModule,DirectoryListingModule" resourceType="Either" requireAccess="Read" />
      </handlers>
      <staticContent>
        <remove fileExtension="." />
        <mimeMap fileExtension="." mimeType="text/plain" />
      </staticContent>
    </system.webServer>
  </location>
</configuration>
