@page "/Error"
@layout AuthLayout
@attribute [ExcludeFromInteractiveRouting]

<PageTitle>Error - MedStock</PageTitle>
<div class="text-center py-12 px-4">
    <MudText Typo="Typo.h3" Class="mb-3">Something went wrong</MudText>
    <MudText Color="Color.Secondary" Class="mb-6">An unexpected error occurred. Please try again.</MudText>
    <MudButton Href="/" Variant="Variant.Filled" Color="Color.Primary">Back to MedStock</MudButton>
</div>
