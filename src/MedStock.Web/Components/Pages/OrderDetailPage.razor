@page "/orders/{Id:int}"
@attribute [Authorize]
@inherits LiveComponentBase
@inject OrderService OrderSvc
@inject ISnackbar Snack
@inject IDialogService Dialogs
@inject NavigationManager Nav

<PageTitle>@(_o?.Number ?? "Order") - MedStock</PageTitle>

@if (_missing)
{
    <MudAlert Severity="Severity.Warning">Order not found. <MudLink Href="/orders">Back to orders</MudLink></MudAlert>
}
else if (_o is null)
{
    <MudProgressLinear Indeterminate="true" />
}
else
{
    <MudBreadcrumbs Items="_crumbs" Class="px-0 pt-0" />
    <div class="page-head">
        <div>
            <MudText Typo="Typo.h3" Class="mb-1">@_o.Number</MudText>
            <MudText Color="Color.Secondary">@_o.Customer &middot; fulfilled from @_o.Warehouse &middot; created @_o.CreatedUtc.ToLocalTime().ToString("MMM d HH:mm")</MudText>
        </div>
        <div class="d-flex gap-2 flex-wrap">
            @if (CanFulfill && OrderWorkflow.Next(_o.Status) is { } next)
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Advance" StartIcon="@(next == OrderStatus.Picking ? Icons.Material.Rounded.Checklist : Icons.Material.Rounded.LocalShipping)">@(next == OrderStatus.Picking ? "Start picking" : "Mark shipped")</MudButton>
            }
            @if (CanManage && _o.HasShortfall && _o.Status is OrderStatus.Pending or OrderStatus.Allocated)
            {
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="Reallocate" StartIcon="@Icons.Material.Rounded.Refresh">Retry allocation</MudButton>
            }
            @if (CanManage && OrderEditRules.CanEditLines(_o.Status))
            {
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="EditLines" StartIcon="@Icons.Material.Rounded.Edit">Edit lines</MudButton>
            }
            @if (IsAdmin && _o.Status == OrderStatus.Cancelled)
            {
                <MudButton Variant="Variant.Outlined" Color="Color.Error" OnClick="DeleteOrder" StartIcon="@Icons.Material.Rounded.DeleteOutline">Delete order</MudButton>
            }
            @if (CanManage && OrderWorkflow.IsOpen(_o.Status))
            {
                <MudButton Variant="Variant.Outlined" Color="Color.Error" OnClick="Cancel" StartIcon="@Icons.Material.Rounded.Close">Cancel order</MudButton>
            }
        </div>
    </div>

    <MudPaper Elevation="0" Class="panel pa-4 mb-3">
        <div class="status-flow" role="list" aria-label="Order progress">
            @foreach (var s in Flow)
            {
                var state = _o.Status == OrderStatus.Cancelled ? "off" : s < _o.Status ? "done" : s == _o.Status ? "now" : "todo";
                <div class="@($"flow-step {state}")" role="listitem"><span class="flow-dot">@(state == "done" ? "✓" : (int)s + 1)</span><span>@s</span></div>
            }
            @if (_o.Status == OrderStatus.Cancelled) { <MudChip T="string" Color="Color.Default" Variant="Variant.Outlined">Cancelled</MudChip> }
        </div>
    </MudPaper>

    <MudPaper Elevation="0" Class="panel pa-4">
        <MudText Typo="Typo.h6" Class="mb-3">Lines and FEFO allocation</MudText>
        @foreach (var l in _o.Lines)
        {
            <div class="mb-4">
                <div class="d-flex justify-space-between flex-wrap">
                    <MudText Typo="Typo.body1" Class="font-weight-semibold">@l.Name <span class="text-secondary-soft">@l.Sku</span></MudText>
                    <MudText Typo="Typo.body2"><span class="num">@l.Allocated</span> / @l.Ordered allocated@(l.Shipped > 0 ? $", {l.Shipped} shipped" : "")</MudText>
                </div>
                <MudProgressLinear Value="@(l.Ordered == 0 ? 0 : 100.0 * l.Allocated / l.Ordered)" Color="@(l.Allocated < l.Ordered ? Color.Warning : Color.Success)" Size="Size.Small" Rounded="true" Class="my-2" aria-label="@($"{l.Name} allocation")" />
                @foreach (var a in l.Lots)
                {
                    <div class="d-flex justify-space-between alloc-row"><span>Lot @a.LotNumber &middot; exp @a.Expiry.ToString("yyyy-MM-dd")</span><span class="num">@a.Quantity</span></div>
                }
            </div>
        }
    </MudPaper>
}

@code {
    private static readonly OrderStatus[] Flow = [OrderStatus.Pending, OrderStatus.Allocated, OrderStatus.Picking, OrderStatus.Shipped];
    [Parameter] public int Id { get; set; }
    private OrderResult? _o;
    private bool _missing;
    private readonly List<BreadcrumbItem> _crumbs = [new("Orders", "/orders"), new("Order", null, true)];

    protected override Topic Topics => Topic.Orders;

    protected override async Task LoadAsync()
    {
        _o = await OrderSvc.GetAsync(Id);
        _missing = _o is null;
    }

    private async Task Advance()
    {
        var r = await OrderSvc.AdvanceAsync(Id, Me);
        Snack.Add(r.Ok ? $"Order is now {r.Value!.Status}" : r.Error!, r.Ok ? Severity.Success : Severity.Error);
        await LoadAsync();
    }

    private async Task Reallocate()
    {
        var r = await OrderSvc.ReallocateAsync(Id, Me);
        Snack.Add(r.Ok ? "Allocation updated" : r.Error!, r.Ok ? Severity.Success : Severity.Error);
        await LoadAsync();
    }

    private async Task EditLines()
    {
        var parameters = new DialogParameters<OrderLinesDialog> { { d => d.Order, _o! }, { d => d.Me, Me } };
        var dlg = await Dialogs.ShowAsync<OrderLinesDialog>(null, parameters, new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true });
        var res = await dlg.Result;
        if (res is { Canceled: false }) { Snack.Add("Order updated and re-allocated", Severity.Success); await LoadAsync(); }
    }

    private async Task DeleteOrder()
    {
        var ok = await Dialogs.ShowMessageBoxAsync($"Delete {_o!.Number}?", "This permanently removes the cancelled order. It never moved stock.", yesText: "Delete", cancelText: "Keep");
        if (ok != true) return;
        var r = await OrderSvc.DeleteAsync(Id, Me);
        if (r.Ok) { Snack.Add("Order deleted", Severity.Success); Nav.NavigateTo("/orders"); }
        else Snack.Add(r.Error!, Severity.Error);
    }

    private async Task Cancel()
    {
        var ok = await Dialogs.ShowMessageBoxAsync($"Cancel {_o!.Number}?", "Reserved stock is released. The order stays in the list as Cancelled.", yesText: "Cancel order", cancelText: "Keep order");
        if (ok != true) return;
        var r = await OrderSvc.CancelAsync(Id, Me);
        Snack.Add(r.Ok ? "Order cancelled, stock released" : r.Error!, r.Ok ? Severity.Info : Severity.Error);
        await LoadAsync();
    }
}
