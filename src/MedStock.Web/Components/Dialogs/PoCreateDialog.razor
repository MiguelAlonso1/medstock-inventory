@inject PurchasingService Svc
@inject InventoryQueries Queries

<MudDialog>
    <TitleContent><MudText Typo="Typo.h6">New purchase order</MudText></TitleContent>
    <DialogContent>
        <MudForm @ref="_form" @bind-IsValid="_valid">
            <MudGrid Spacing="2">
                <MudItem xs="12" sm="6">
                    <MudSelect T="int?" Value="_supplierId" ValueChanged="OnSupplier" Label="Supplier" Variant="Variant.Outlined" Required="true"
                               Validation="@((Func<int?, string?>)(v => v is null ? "Choose a supplier" : null))">
                        @foreach (var s in Suppliers) { <MudSelectItem T="int?" Value="@((int?)s.Id)">@s.Name &middot; @s.LeadTimeDays d lead</MudSelectItem> }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudSelect T="int?" @bind-Value="_warehouseId" Label="Receive at" Variant="Variant.Outlined" Required="true"
                               Validation="@((Func<int?, string?>)(v => v is null ? "Choose a warehouse" : null))">
                        @foreach (var w in Warehouses) { <MudSelectItem T="int?" Value="@((int?)w.Id)">@w.Code &middot; @w.Name@(w.ColdChainCapable ? " (cold chain)" : "")</MudSelectItem> }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudDatePicker Date="_expected" DateChanged="@(d => _expected = d)" Label="Expected date" Variant="Variant.Outlined" Editable="true" MinDate="DateTime.Today" />
                </MudItem>
            </MudGrid>
            <MudText Typo="Typo.subtitle1" Class="mt-4 mb-1">Lines (products of the chosen supplier)</MudText>
            @for (var i = 0; i < _lines.Count; i++)
            {
                var line = _lines[i];
                <MudGrid Spacing="2" Class="align-start">
                    <MudItem xs="12" sm="7">
                        <MudAutocomplete T="ProductOption" @bind-Value="line.Product" SearchFunc="SearchProducts" ToStringFunc="@(p => p?.ToString())" Disabled="@(_supplierId is null)"
                                         Label="Product" Variant="Variant.Outlined" Required="true" RequiredError="Choose a product" CoerceText="false" ResetValueOnEmptyText="true"
                                         MaxItems="25" DebounceInterval="200" />
                    </MudItem>
                    <MudItem xs="8" sm="3">
                        <MudNumericField T="int" @bind-Value="line.Quantity" Label="Quantity" Variant="Variant.Outlined" Min="1" Max="1000000"
                                         Validation="@((Func<int, string?>)(v => v < 1 ? "At least 1" : null))" />
                    </MudItem>
                    <MudItem xs="4" sm="2" Class="d-flex align-center" Style="min-height:56px">
                        <MudIconButton Icon="@Icons.Material.Rounded.DeleteOutline" Disabled="@(_lines.Count == 1)" OnClick="() => _lines.Remove(line)" aria-label="Remove line" />
                    </MudItem>
                </MudGrid>
            }
            <MudButton Variant="Variant.Text" Color="Color.Primary" StartIcon="@Icons.Material.Rounded.Add" OnClick="() => _lines.Add(new())">Add line</MudButton>
        </MudForm>
        @if (_error is not null) { <MudAlert Severity="Severity.Error" Dense="true" Class="mt-3">@_error</MudAlert> }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Save" Disabled="_busy" StartIcon="@Icons.Material.Rounded.Check">Create purchase order</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public IReadOnlyList<Supplier> Suppliers { get; set; } = [];
    [Parameter] public IReadOnlyList<Warehouse> Warehouses { get; set; } = [];
    [Parameter] public Caller Me { get; set; } = default!;

    private sealed class LineModel { public ProductOption? Product { get; set; } public int Quantity { get; set; } = 1; }

    private MudForm _form = default!;
    private bool _valid, _busy;
    private string? _error;
    private int? _supplierId, _warehouseId;
    private DateTime? _expected;
    private readonly List<LineModel> _lines = [new()];

    private void OnSupplier(int? id)
    {
        _supplierId = id;
        foreach (var l in _lines) l.Product = null;   // products depend on the supplier
        if (id is { } sid && Suppliers.FirstOrDefault(s => s.Id == sid) is { } s) _expected = DateTime.Today.AddDays(s.LeadTimeDays);
    }

    private async Task<IEnumerable<ProductOption>> SearchProducts(string? term, CancellationToken ct) => await Queries.SearchProductsAsync(term, 25, _supplierId);

    private void Cancel() => MudDialog.Cancel();

    private async Task Save()
    {
        _error = null;
        await _form.ValidateAsync();
        if (!_valid || _lines.Any(l => l.Product is null)) { _error ??= "Complete the highlighted fields."; return; }
        _busy = true;
        try
        {
            var r = await Svc.CreateManualAsync(_supplierId ?? 0, _warehouseId ?? 0, _expected is { } d ? DateOnly.FromDateTime(d) : null,
                _lines.Select(l => new NewOrderLine(l.Product!.Id, l.Quantity)).ToList(), Me);
            if (r.Ok) MudDialog.Close(DialogResult.Ok(r.Value));
            else _error = r.Error;
        }
        finally { _busy = false; }
    }
}
